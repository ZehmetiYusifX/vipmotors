# ─────────────────────────────────────────────────────────────
# VIP Motors — environment variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# `.env*` files are gitignored (except this example) — never commit
# real secrets.
# ─────────────────────────────────────────────────────────────

# Base URL of the VIP Motors backend API.
# Public: the NEXT_PUBLIC_ prefix exposes this to the browser, so do NOT
# put secrets here. Used by lib/api/client.ts; if unset it falls back to
# the value below.
NEXT_PUBLIC_API_BASE_URL=http://109.199.106.116:8080

# OpenAI API key for the AI oil-assistant chat (app/api/chat, model gpt-4o).
# Server-only — must NOT be prefixed with NEXT_PUBLIC and is never sent to
# the browser. Required for the /oils chat to return AI answers.
OPENAI_API_KEY=sk-your-openai-key-here
